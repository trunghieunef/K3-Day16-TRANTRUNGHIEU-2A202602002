# =====================================================================
# Checklist so 6 - KHONG duoc nap kem theo thu muc terraform/:
#   - state            : *.tfstate, *.tfstate.*
#   - thu muc .terraform/
#   - private/pub key  : lab-key, lab-key.pub
#   - Kaggle credential: kaggle.json
# Tat ca cac file nay deu bi ignore (khong vao commit/zip submission).
# =====================================================================

# Terraform local state and backups
**/.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# SSH Keys
lab-key
lab-key.pub

# Environment Variables
.env
.env.local

# Kaggle API credentials (Lab 16) - never commit
kaggle.json
.kaggle/

# Generic private keys / secrets
*.key
*.pem
*.p12
*.cer